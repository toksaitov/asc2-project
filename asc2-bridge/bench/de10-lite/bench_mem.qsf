set_location_assignment PIN_B11 -to LEDR[9]

# The 16 wired header pins, by port name. Locations are the Terasic
# GPIO[n] locations for header pins 2, 4, 8 ... 40.
set_location_assignment PIN_W10 -to pi_rst_n
set_instance_assignment -name IO_STANDARD "3.3 V Schmitt Trigger" -to pi_rst_n
set_instance_assignment -name WEAK_PULL_UP_RESISTOR OFF -to pi_rst_n
set_instance_assignment -name ENABLE_BUS_HOLD_CIRCUITRY OFF -to pi_rst_n
set_location_assignment PIN_W9 -to pi_clk
# CLK and the other Pico-driven inputs come over bare jumper wires.
# Hysteresis keeps ground bounce and crosstalk (simultaneously switching
# uio outputs, the CLK wire next to RST_N) from making extra clock
# edges or short reset pulses. uio is bidirectional and stays LVTTL.
set_instance_assignment -name IO_STANDARD "3.3 V Schmitt Trigger" -to pi_clk
set_instance_assignment -name WEAK_PULL_UP_RESISTOR OFF -to pi_clk
set_instance_assignment -name ENABLE_BUS_HOLD_CIRCUITRY OFF -to pi_clk
set_location_assignment PIN_W7 -to uio[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to uio[0]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR OFF -to uio[0]
set_instance_assignment -name ENABLE_BUS_HOLD_CIRCUITRY OFF -to uio[0]
set_location_assignment PIN_V5 -to uio[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to uio[1]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR OFF -to uio[1]
set_instance_assignment -name ENABLE_BUS_HOLD_CIRCUITRY OFF -to uio[1]
set_location_assignment PIN_AA15 -to uio[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to uio[2]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR OFF -to uio[2]
set_instance_assignment -name ENABLE_BUS_HOLD_CIRCUITRY OFF -to uio[2]
set_location_assignment PIN_W13 -to uio[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to uio[3]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR OFF -to uio[3]
set_instance_assignment -name ENABLE_BUS_HOLD_CIRCUITRY OFF -to uio[3]
set_location_assignment PIN_AB13 -to uio[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to uio[4]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR OFF -to uio[4]
set_instance_assignment -name ENABLE_BUS_HOLD_CIRCUITRY OFF -to uio[4]
set_location_assignment PIN_Y11 -to uio[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to uio[5]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR OFF -to uio[5]
set_instance_assignment -name ENABLE_BUS_HOLD_CIRCUITRY OFF -to uio[5]
set_location_assignment PIN_W11 -to uio[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to uio[6]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR OFF -to uio[6]
set_instance_assignment -name ENABLE_BUS_HOLD_CIRCUITRY OFF -to uio[6]
set_location_assignment PIN_AA10 -to uio[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to uio[7]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR OFF -to uio[7]
set_instance_assignment -name ENABLE_BUS_HOLD_CIRCUITRY OFF -to uio[7]
set_location_assignment PIN_Y7 -to req
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to req
set_instance_assignment -name WEAK_PULL_UP_RESISTOR OFF -to req
set_instance_assignment -name ENABLE_BUS_HOLD_CIRCUITRY OFF -to req
set_location_assignment PIN_Y6 -to pi_ack
set_instance_assignment -name IO_STANDARD "3.3 V Schmitt Trigger" -to pi_ack
set_instance_assignment -name WEAK_PULL_UP_RESISTOR OFF -to pi_ack
set_instance_assignment -name ENABLE_BUS_HOLD_CIRCUITRY OFF -to pi_ack
set_location_assignment PIN_Y5 -to pi_irq
set_instance_assignment -name IO_STANDARD "3.3 V Schmitt Trigger" -to pi_irq
set_instance_assignment -name WEAK_PULL_UP_RESISTOR OFF -to pi_irq
set_instance_assignment -name ENABLE_BUS_HOLD_CIRCUITRY OFF -to pi_irq
set_location_assignment PIN_Y4 -to pi_dbg_ck
set_instance_assignment -name IO_STANDARD "3.3 V Schmitt Trigger" -to pi_dbg_ck
set_instance_assignment -name WEAK_PULL_UP_RESISTOR OFF -to pi_dbg_ck
set_instance_assignment -name ENABLE_BUS_HOLD_CIRCUITRY OFF -to pi_dbg_ck
set_location_assignment PIN_Y3 -to pi_dbg_di
set_instance_assignment -name IO_STANDARD "3.3 V Schmitt Trigger" -to pi_dbg_di
set_instance_assignment -name WEAK_PULL_UP_RESISTOR OFF -to pi_dbg_di
set_instance_assignment -name ENABLE_BUS_HOLD_CIRCUITRY OFF -to pi_dbg_di
set_location_assignment PIN_AA2 -to dbg_do
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to dbg_do
set_instance_assignment -name WEAK_PULL_UP_RESISTOR OFF -to dbg_do
set_instance_assignment -name ENABLE_BUS_HOLD_CIRCUITRY OFF -to dbg_do

# Lowest drive strength on the pins this design can drive.
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to uio[*]
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to req
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to dbg_do


# CLK from the Pico drives the global clock network (CLK wire monitor).
set_instance_assignment -name GLOBAL_SIGNAL "GLOBAL CLOCK" -to pi_clk
# The chip clock (the divider, or the CLK wire for the torture test) drives
# the global clock network.
set_instance_assignment -name GLOBAL_SIGNAL "GLOBAL CLOCK" -to clk_mux
