# Bench Test 4 (memory proof), DE10-Lite side. Loaded over JTAG (.sof) only; the
# board's configuration flash is never written.
set_global_assignment -name FAMILY "MAX 10 FPGA"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY bench_mem
set_global_assignment -name SYSTEMVERILOG_FILE ../../../../ttsky26e-almurut2/src/asc_reset_filter.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../../ttsky26e-almurut2/src/asc_irq_filter.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../../ttsky26e-almurut2/src/asc_bus.sv
# Bench only: asc_bus's tear test input (the chip is built without it).
set_global_assignment -name VERILOG_MACRO "ASC_BUS_TEST_TEAR=1"
set_global_assignment -name SYSTEMVERILOG_FILE dly_line.sv
set_global_assignment -name SYSTEMVERILOG_FILE bench_mem.sv
set_global_assignment -name SDC_FILE bench_mem.sdc
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_WEAK_PULLUP "AS INPUT TRI-STATED WITH WEAK PULL-UP"
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"

# Clock, LEDs and displays, copied from the Terasic DE10_LITE_Golden_Top.qsf.
set_location_assignment PIN_P11 -to clk50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk50
