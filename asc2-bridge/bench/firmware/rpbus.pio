; Bench Test 4: the RP end of bus protocol v1, byte handshake in PIO.
;
; One REQ toggle is one event. For every event the state machine:
; 1. takes one command word from the TX FIFO (it waits here, holding the
;    chip, until core 1 has decided the answer);
; 2. waits for REQ to reach the new level, and to still be there 3 cycles
;    later (20 ns at 150 MHz: a glitch shorter than that is not an
;    event); REQ cannot move again before the ACK below, so an edge that
;    came early is not lost;
; 3. samples uio and pushes the byte to the RX FIFO (autopush at 8);
; 4. drives a byte, or releases uio, as the command says;
; 5. toggles ACK.
;
; Command word (OUT shifts right):
;   [7:0]   byte to drive
;   [8]     1 drive, 0 receive or release
;   [16:9]  uio pin directions (0xFF while driving, 0 otherwise)
;
; Pins:
;   IN/OUT base  uio[0] (GP2), 8 pins; REQ is IN pin 8 (GP10)
;   SET base     ACK (GP11)
;   side-set     PDRV (GP14), high while the RP drives uio (bench safety
;                net, read by the DE10)
;   JMP pin      CDRV (GP15), high while the chip drives uio
;
; Before turning its outputs on, the state machine checks CDRV. If the
; chip claims uio, it raises PIO IRQ 0 and stops with its outputs off.
;
; Recovery (v1): when the chip goes quiet mid-transaction, core 1 stops
; the state machine, releases uio, and restarts it at "rise" or "fall"
; to match REQ's present level, so the next REQ change is a header.

.program rpbus
.side_set 1 opt

.wrap_target
public rise:
    pull block
    wait 1 pin 8 [2]
    wait 1 pin 8
    in pins, 8
    out pins, 8
    out x, 1
    jmp !x rise_rel
    jmp pin viol
    out pindirs, 8 side 1 [3]    ; data settles before ACK
    set pins, 1
    jmp fall
rise_rel:
    out pindirs, 8 side 0 [1]
    set pins, 1
public fall:
    pull block
    wait 0 pin 8 [2]
    wait 0 pin 8
    in pins, 8
    out pins, 8
    out x, 1
    jmp !x fall_rel
    jmp pin viol
    out pindirs, 8 side 1 [3]
    set pins, 0
    jmp rise
fall_rel:
    out pindirs, 8 side 0 [1]
    set pins, 0
.wrap
viol:
    irq nowait 0
halt:
    jmp halt

; Bench diagnostics, in the second PIO block: watches REQ and reports
; pulses shorter than about 3 cycles (20 ns at 150 MHz), which a real REQ
; toggle never is (it holds for a whole round trip). Pushes 0 for a short
; high pulse and 1 for a short low pulse; core 0 counts them. It changes
; nothing on the bus.
;
; Pins: IN base and JMP pin both REQ (GP10).

.program reqwatch

.wrap_target
low:
    wait 1 pin 0
    nop [1]
    jmp pin high
    mov isr, null
    push noblock
    jmp low
high:
    wait 0 pin 0
    nop [1]
    jmp pin short_low
    jmp low
short_low:
    set x, 1
    mov isr, x
    push noblock
    jmp high
.wrap
